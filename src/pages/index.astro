---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PythonMap MK2 - High-Performance Code Browser">
  <div class="flex-1 flex items-center justify-center">
    <div class="text-center max-w-4xl mx-auto px-6">
      <div class="mb-8">
        <h1 class="text-6xl font-bold text-blue-400 mb-4">
          PythonMap MK2
        </h1>
        <p class="text-xl text-gray-300 mb-8">
          High-performance code browser built with Astro + Svelte
        </p>
        <div class="flex items-center justify-center gap-8 text-sm text-gray-400 mb-12">
          <div class="flex items-center gap-2">
            <span class="text-purple-400">⚡</span>
            <span>Lightning Fast</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-green-400">🚀</span>
            <span>GitHub Pages Ready</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-blue-400">📱</span>
            <span>Mobile Optimized</span>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <a 
          href="/browser" 
          class="group bg-gray-800 rounded-lg p-8 border border-gray-700 hover:border-blue-500 transition-all duration-200 hover:bg-gray-750"
        >
          <div class="text-5xl mb-4">📁</div>
          <h2 class="text-2xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">
            File Browser
          </h2>
          <p class="text-gray-400 group-hover:text-gray-300 transition-colors">
            Browse and view code files with syntax highlighting and perfect line alignment
          </p>
        </a>

        <a 
          href="/notepads" 
          class="group bg-gray-800 rounded-lg p-8 border border-gray-700 hover:border-green-500 transition-all duration-200 hover:bg-gray-750"
        >
          <div class="text-5xl mb-4">📝</div>
          <h2 class="text-2xl font-bold text-white mb-2 group-hover:text-green-400 transition-colors">
            Notepads
          </h2>
          <p class="text-gray-400 group-hover:text-gray-300 transition-colors">
            Interactive code walkthroughs with documentation and annotations
          </p>
        </a>
      </div>

      <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
        <h3 class="text-lg font-semibold text-gray-200 mb-4">Key Improvements in MK2</h3>
        <div class="grid md:grid-cols-3 gap-6 text-sm">
          <div class="text-center">
            <div class="text-blue-400 font-bold">⚡ Performance</div>
            <div class="text-gray-400 mt-1">Optimized Astro + Svelte architecture</div>
          </div>
          <div class="text-center">
            <div class="text-green-400 font-bold">🎯 Line Alignment</div>
            <div class="text-gray-400 mt-1">Perfect line number synchronization</div>
          </div>
          <div class="text-center">
            <div class="text-purple-400 font-bold">🔧 Reliability</div>
            <div class="text-gray-400 mt-1">Better error handling and fallbacks</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
