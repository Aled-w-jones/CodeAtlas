---
import Layout from '../layouts/Layout.astro';

// Helper function to get the correct path with base
function getPath(path: string): string {
  const base = import.meta.env.BASE_URL || '/';
  return base === '/' ? path : base.replace(/\/$/, '') + path;
}
---

<Layout title="PythonMap MK2 - VS Code-Style Python Code Browser">
  <div class="container mx-auto px-4 py-8 h-full flex items-center justify-center">
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <div class="bg-vsc-bg-medium border border-vsc-border-light rounded-lg p-6 hover:bg-vsc-bg-light transition-colors">
        <h2 class="text-2xl font-semibold mb-4 text-vsc-text-primary">📔 Python Notepads</h2>
        <p class="text-vsc-text-secondary mb-4">
          Browse and view Python scripts with syntax highlighting and annotations.
        </p>
        <a href={getPath("/notepads/")} class="inline-block bg-vsc-accent-blue text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors">
          View Notepads
        </a>
      </div>

      <div class="bg-vsc-bg-medium border border-vsc-border-light rounded-lg p-6 hover:bg-vsc-bg-light transition-colors">
        <h2 class="text-2xl font-semibold mb-4 text-vsc-text-primary">🗂️ Codebase Browser</h2>
        <p class="text-vsc-text-secondary mb-4">
          Navigate through the repository structure and explore files and folders.
        </p>
        <a href={getPath("/browser/")} class="inline-block bg-vsc-accent-blue text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors">
          Browse Code
        </a>
      </div>
    </div>

    <div class="text-center mt-12">
      <p class="text-vsc-text-secondary">
        A high-performance web application built with Astro islands and Svelte components, designed with VS Code aesthetics
      </p>
    </div>
  </div>
</Layout>
