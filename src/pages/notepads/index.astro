---
import Layout from '../../layouts/Layout.astro';

// Helper function to get the correct path with base
function getPath(path: string): string {
  const base = import.meta.env.BASE_URL || '/';
  return base === '/' ? path : base.replace(/\/$/, '') + path;
}
---

<Layout title="Notepads - PythonMap MK2">
  <div class="flex-1 flex items-center justify-center">
    <div class="text-center max-w-3xl mx-auto px-6">
      <div class="mb-8">
        <div class="text-8xl mb-6">📝</div>
        <h1 class="text-4xl font-bold text-green-400 mb-4">
          Interactive Notepads
        </h1>
        <p class="text-xl text-gray-300 mb-8">
          Coming soon! Interactive code walkthroughs with annotations and step-by-step guides.
        </p>
      </div>

      <div class="bg-gray-800 rounded-lg p-8 border border-gray-700 mb-8">
        <h2 class="text-2xl font-bold text-gray-200 mb-4">Planned Features</h2>
        <div class="grid md:grid-cols-2 gap-6 text-left">
          <div>
            <h3 class="text-lg font-semibold text-blue-400 mb-2">📖 Interactive Walkthroughs</h3>
            <p class="text-gray-400">Step-by-step code explanations with highlighting and annotations</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-green-400 mb-2">🎯 Code Annotations</h3>
            <p class="text-gray-400">Detailed explanations for specific lines and functions</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-purple-400 mb-2">📚 Learning Paths</h3>
            <p class="text-gray-400">Structured learning sequences for different skill levels</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-orange-400 mb-2">💡 Best Practices</h3>
            <p class="text-gray-400">Code quality tips and Python best practices</p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-center gap-6">
        <a 
          href={getPath("/browser/")} 
          class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200"
        >
          🔍 Browse Code Files
        </a>
        <a 
          href={getPath("/")} 
          class="bg-gray-700 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200"
        >
          🏠 Back to Home
        </a>
      </div>

      <div class="mt-8 text-sm text-gray-500">
        <p>This feature is in development. Check back soon for interactive code tutorials!</p>
      </div>
    </div>
  </div>
</Layout>