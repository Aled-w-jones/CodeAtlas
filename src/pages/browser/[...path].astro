---
import Layout from '../../layouts/Layout.astro';
import EnhancedCodeBrowser from '../../components/EnhancedCodeBrowser.svelte';
import { getDirectoryListing, getFileContent, fileExists, buildSearchIndex } from '../../utils/file-helpers';
import { readdirSync, statSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const scriptsDir = join(process.cwd(), 'scripts');
  const paths = [];

  function getAllPaths(dir: string, basePath: string = '') {
    try {
      const items = readdirSync(dir);
      
      for (const item of items) {
        const fullPath = join(dir, item);
        const relativePath = basePath ? `${basePath}/${item}` : item;
        
        try {
          const stat = statSync(fullPath);
          
          if (stat.isDirectory()) {
            // Add directory path
            paths.push({ params: { path: relativePath } });
            // Recursively get subdirectory contents
            getAllPaths(fullPath, relativePath);
          } else {
            // Add file path
            paths.push({ params: { path: relativePath } });
          }
        } catch (error) {
          console.warn(`Skipping ${fullPath}:`, error.message);
        }
      }
    } catch (error) {
      console.warn(`Could not read directory ${dir}:`, error.message);
    }
  }

  getAllPaths(scriptsDir);
  return paths;
}

const { path } = Astro.params;
const decodedPath = path ? decodeURIComponent(path) : '';

// Check if the path exists
if (!fileExists(decodedPath)) {
  return Astro.redirect('/browser');
}

// Process the path to create MK1-style pageData
let pageData = null;
let searchIndex = [];

try {
  // Build search index for the entire project
  searchIndex = buildSearchIndex('');
  
  // Try to get file content first
  const fileContent = getFileContent(decodedPath);
  
  if (fileContent) {
    // It's a file - create file pageData
    const pathParts = decodedPath.split('/');
    const fileName = pathParts.pop();
    const parentPath = pathParts.join('/');
    
    pageData = {
      type: 'file',
      name: fileContent.name,
      path: decodedPath,
      content: fileContent.content,
      rawContent: fileContent.rawContent,
      extension: fileContent.name.split('.').pop()?.toLowerCase(),
      readmeContent: fileContent.readmeContent,
      rawReadmeContent: fileContent.rawReadmeContent,
      isMarkdownRendered: fileContent.isMarkdownRendered,
      breadcrumbs: decodedPath ? decodedPath.split('/') : []
    };
  } else {
    // It's a directory - create directory pageData
    const listing = getDirectoryListing(decodedPath);
    
    pageData = {
      type: 'directory',
      path: decodedPath || 'scripts',
      items: [...listing.directories, ...listing.files].map(item => ({
        name: item.name,
        path: item.url.replace('/pythonmap-mk2/browser/', ''),
        type: item.isDirectory ? 'directory' : 'file',
        extension: item.isDirectory ? null : item.name.split('.').pop()?.toLowerCase(),
        size: item.size
      })),
      readmeContent: null, // TODO: Add directory README support
      breadcrumbs: decodedPath ? decodedPath.split('/') : []
    };
  }
} catch (error) {
  console.error('Error processing path:', error);
  return Astro.redirect('/browser');
}

const title = pageData?.type === 'file' 
  ? `${pageData.name} - File Browser`
  : `${pageData.path || 'Root'} - File Browser`;
---

<Layout title={title}>
  <EnhancedCodeBrowser 
    client:load
    searchIndex={searchIndex}
    pageData={pageData}
  />
</Layout>