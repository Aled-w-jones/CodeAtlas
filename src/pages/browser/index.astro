---
import Layout from '../../layouts/Layout.astro';
import EnhancedCodeBrowser from '../../components/EnhancedCodeBrowser.svelte';
import { getDirectoryListing, buildSearchIndex } from '../../utils/file-helpers';

const listing = getDirectoryListing();
const searchIndex = buildSearchIndex('');

// Create pageData structure for directory view like the [...path].astro does
const pageData = {
  type: 'directory',
  path: 'scripts',
  items: [...listing.directories, ...listing.files].map(item => ({
    name: item.name,
    path: item.url.replace('/CodeAtlas/browser/', ''),
    type: item.isDirectory ? 'directory' : 'file',
    extension: item.isDirectory ? null : item.name.split('.').pop()?.toLowerCase(),
    size: item.size
  })),
  readmeContent: null,
  breadcrumbs: []
};
---

<Layout title="File Browser - PythonMap MK2">
  <EnhancedCodeBrowser 
    client:load
    searchIndex={searchIndex}
    pageData={pageData}
  />
</Layout>