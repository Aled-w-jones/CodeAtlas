---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'PythonMap MK2 - High-performance code browser with Astro and Svelte' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-900 text-gray-100 font-mono h-full">
    <div class="layout-container">
      <header class="bg-gray-800 border-b border-gray-700 px-6 py-4 flex-shrink-0">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold text-blue-400">
            <a href="/" class="hover:text-blue-300 transition-colors duration-200">PythonMap MK2</a>
          </h1>
          <nav class="flex items-center gap-6">
            <a href="/browser" class="text-gray-300 hover:text-white transition-colors duration-200 px-3 py-2 rounded hover:bg-gray-700">Browser</a>
            <a href="/notepads" class="text-gray-300 hover:text-white transition-colors duration-200 px-3 py-2 rounded hover:bg-gray-700">Notepads</a>
          </nav>
        </div>
      </header>
      
      <main class="flex-1 overflow-hidden">
        <slot />
      </main>
      
      <footer class="bg-gray-800 border-t border-gray-700 px-6 py-3 text-center text-gray-400 text-sm flex-shrink-0">
        Built with <span class="text-purple-400 font-semibold">Astro</span> + <span class="text-orange-400 font-semibold">Svelte</span> for maximum performance
      </footer>
    </div>
  </body>
</html>